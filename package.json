{
	"name": "skill-kit",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --filter '@skill-kit/web' dev",
		"build": "bun run --filter '*' build",
		"build:cli": "bun run --filter '@skill-kit/cli' build",
		"build:web": "bun run --filter '@skill-kit/web' build",
		"lint": "biome check --write .",
		"lint:check": "biome check .",
		"type-check": "bun run --filter '*' type-check"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"typescript": "^5.9.3"
	}
}
