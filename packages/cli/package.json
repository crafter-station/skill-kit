{
	"name": "@crafter/skillkit",
	"version": "0.12.0",
	"description": "Local-first analytics for AI agent skills. Track usage, measure context budget, and prune what you don't use.",
	"type": "module",
	"bin": {
		"skillkit": "./src/bin.ts"
	},
	"files": [
		"src",
		"README.md",
		"AGENTS.md",
		"CLAUDE.md"
	],
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"scripts": {
		"dev": "bun run src/bin.ts",
		"build": "bun build src/bin.ts --compile --outfile dist/skillkit",
		"test": "bun test src/",
		"type-check": "tsc --noEmit"
	},
	"keywords": [
		"skillkit",
		"skills",
		"analytics",
		"claude-code",
		"cursor",
		"ai-agent",
		"agents",
		"agent-skills",
		"observability",
		"context-window",
		"cli",
		"anthropic",
		"mcp",
		"bun"
	],
	"author": "Crafter Station <the.crafter.station@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/crafter-station/skill-kit.git",
		"directory": "packages/cli"
	},
	"homepage": "https://skillkit.crafter.run",
	"bugs": {
		"url": "https://github.com/crafter-station/skill-kit/issues"
	},
	"engines": {
		"bun": ">=1.0.0",
		"node": ">=18.0.0"
	},
	"devDependencies": {
		"@types/bun": "^1.2.14",
		"typescript": "^5.9.3"
	}
}
